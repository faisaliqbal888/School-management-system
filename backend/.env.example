NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_db?schema=public

# Auth — use `openssl rand -hex 32` for each secret in production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# CORS — comma separated browser origins
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Outbound email / SMS (optional) ──────────────────────────
# Off by default. While DELIVERY_ENABLED=false, notices marked EMAIL/SMS are
# still saved in-app and the API reports `delivery.attempted: 0`.
DELIVERY_ENABLED=false
# "generic" POSTs {from,to,subject,text} / {to,message}; "resend" uses Resend's schema
EMAIL_PROVIDER=generic
# EMAIL_API_URL=https://api.resend.com/emails
# EMAIL_API_KEY=re_xxxxxxxx
EMAIL_FROM=no-reply@ravischool.edu.pk
# SMS_API_URL=https://sms-gateway.example.pk/send
# SMS_API_KEY=xxxxxxxx
