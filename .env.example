# ─────────────────────────────────────────────
# Frontend (Next.js) — copy to frontend/.env.local
# ─────────────────────────────────────────────

# URL of the Express backend. The Next.js dev server proxies /api/v1/* here,
# so the browser only ever talks to the frontend origin.
BACKEND_URL=http://localhost:5000

# Public base URL for browser-side calls (defaults to same-origin).
NEXT_PUBLIC_API_BASE_URL=

# ─────────────────────────────────────────────
# Backend (Express) — copy to backend/.env
# ─────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_db?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# CORS — comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Outbound email / SMS — see backend/.env.example
DELIVERY_ENABLED=false
EMAIL_PROVIDER=generic
